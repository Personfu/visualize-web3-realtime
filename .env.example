# SperaxOS Agent API
# WebSocket endpoint for real-time agent events
NEXT_PUBLIC_SPERAXOS_WS_URL=wss://api.speraxos.io/agents/v1/stream

# Never expose an upstream or executor control key through NEXT_PUBLIC variables.

# Keep the bundled viewer in offline demo mode until a scoped viewer-session bridge is configured.
NEXT_PUBLIC_AGENT_MOCK=true

# Executor WebSocket server (for the packages/executor backend)
EXECUTOR_PORT=8765
EXECUTOR_MAX_AGENTS=5
SPERAXOS_URL=https://api.speraxos.io
SPERAXOS_API_KEY=
STATE_PATH=./data/executor.db

# Executor control: generate distinct random base64url values of at least 32 characters.
# Keep both private; the viewer key grants private read access only.
EXECUTOR_HOST=127.0.0.1
EXECUTOR_ACCESS_TOKEN=
EXECUTOR_VIEWER_TOKEN=
EXECUTOR_ALLOWED_ORIGINS=http://localhost:3100
