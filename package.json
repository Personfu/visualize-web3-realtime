{
  "name": "visualize-web3-realtime",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:playground": "turbo run dev --filter=@web3viz/playground",
    "dev:executor": "turbo run dev --filter=@web3viz/executor",
    "build": "next build --webpack",
    "build:web": "next build --webpack",
    "start": "next start -p 3100",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck:web && npm run typecheck:executor && turbo run typecheck",
    "typecheck:web": "tsc --noEmit",
    "test:offline": "tsx --test tests/mock-provider.test.ts tests/executor-access.test.ts tests/react-lifecycle.test.tsx tests/provider-message.test.ts tests/source-privacy.test.ts tests/world-chat-request.test.ts && node --test tests/security/browser-policy.test.mjs",
    "typecheck:executor": "tsc --noEmit --project packages/executor/tsconfig.json",
    "test:ui:offline": "node tests/ui-offline.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "d3-force": "^3.0.0",
    "framer-motion": "^11.0.0",
    "html2canvas": "^1.4.1",
    "next": "16.4.5",
    "postprocessing": "^6.39.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.169.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "playwright": "1.64.1",
    "postcss": "^8.4.0",
    "react-test-renderer": "19.3.1",
    "tailwindcss": "^3.4.0",
    "tsx": "4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": "22.x"
  }
}
